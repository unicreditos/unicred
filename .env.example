# ============================================================
# UniCred — variables de entorno
# Copiá este archivo como .env.local (desarrollo) y cargá los
# mismos valores en el proveedor de hosting para producción.
# ============================================================

# --- Base de datos (obligatorio) ------------------------------
# Cadena de conexión de Neon/Postgres.
DATABASE_URL=postgresql://usuario:password@host.neon.tech/unicred?sslmode=require

# --- Autenticación (obligatorio) ------------------------------
# Secreto de firma de sesiones. Generalo con: openssl rand -base64 48
BETTER_AUTH_SECRET=
# URL base donde corre la app (sin barra final).
BETTER_AUTH_URL=https://unicreditos.com
# Dominios adicionales permitidos, separados por coma.
BETTER_AUTH_TRUSTED_HOSTS=unicreditos.com,www.unicreditos.com,unicreditos.com.ar,unicreditos.store,unicreditos.online
# Cookie compartida solo entre unicreditos.com y www. No sirve para .com.ar / .store.
# BETTER_AUTH_COOKIE_DOMAIN=.unicreditos.com

# --- Sitio (obligatorio) --------------------------------------
# Canónico: unicreditos.com. Los alias .com.ar / .store / .online redirigen acá.
NEXT_PUBLIC_SITE_URL=https://unicreditos.com
NEXT_PUBLIC_SUPPORT_EMAIL=soporte@unicreditos.com
NEXT_PUBLIC_HELP_EMAIL=soporte@unicreditos.com
NEXT_PUBLIC_MERCHANTS_EMAIL=comercios@unicreditos.com
NEXT_PUBLIC_PRIVACY_EMAIL=privacidad@unicreditos.com
# Datos legales que salen en contratos y recibos (públicos, no son secretos).
NEXT_PUBLIC_BRAND_CUIT=30716036010
NEXT_PUBLIC_BRAND_ADDRESS=Maipú 566, piso 4° “D”, C.P. 1006, Ciudad Autónoma de Buenos Aires
NEXT_PUBLIC_BRAND_PHONE=0800-UNICRED
# CBU/CVU de tesorería desde el que se giran los desembolsos (operativo).
TREASURY_CBU=

# --- Mercado Pago (obligatorio en producción) -------------
# Token de la aplicación UniCred (TEST en desarrollo, producción en el host).
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_PUBLIC_KEY=
# Client Secret del panel (OAuth). No lo usa el checkout; se guarda por si hace falta.
# MERCADO_PAGO_CLIENT_SECRET=
# Clave secreta de firma de webhooks (panel de MP → Webhooks).
# Sin esto el webhook rechaza todo y las cuotas no se acreditan.
MERCADO_PAGO_WEBHOOK_SECRET=
# Cron de conciliación (Vercel Cron). Opcional; Vercel manda x-vercel-cron.
# CRON_SECRET=
# Opcionales: solo si necesitás sobrescribir los valores por defecto.
# MERCADO_PAGO_BASE_URL=https://api.mercadopago.com
# MERCADO_PAGO_REDIRECT_URL=https://unicreditos.com
# MERCADO_PAGO_NOTIFICATION_URL=https://unicreditos.com/api/webhooks/mercadopago

# --- Correo transaccional -------------------------------------
# Sin esto no se envían los mails de recuperación de contraseña ni los avisos de movimiento.
RESEND_API_KEY=
EMAIL_FROM=UNICRÉDITOS <no-responder@unicreditos.com>
# Copia operativa (BCC) en pagos, desembolsos y rechazos. Por defecto: NEXT_PUBLIC_SUPPORT_EMAIL.
# EMAIL_OPS=soporte@unicreditos.com

# --- Validación de CBU/CVU/alias (opcional) -------------------
ARGENAPI_API_KEY=
ARGENAPI_BASE_URL=https://api.argenapi.com
ARGENAPI_TIMEOUT_MS=15000

# --- ARCA / AFIP (padrón de contribuyentes) -------------------
# En local UniCred carga solo el certificado, la clave y el CUIT desde
# emitia/certificates y emitia/.env.local. No hace falta copiarlos acá.
# En hosting, si no viaja la carpeta emitia, definí:
# AFIP_CUIT=
# AFIP_ENVIRONMENT=production
# AFIP_CERT=
# AFIP_KEY=
# EMITIA_ROOT=/ruta/a/emitia

# --- Didit (verificación de identidad, obligatorio en prod) ---
# Consola: Developers → API keys / Workflows / Webhooks
# https://business.didit.me
DIDIT_API_KEY=
# UUID del workflow publicado (config, no es secreto). Si está vacío, se usa el default publicado.
DIDIT_WORKFLOW_ID=
# secret_shared_key del destino de webhook (API & Webhooks).
DIDIT_WEBHOOK_SECRET=
# Aplicación UniCred en Didit (solo referencia / auditoría).
DIDIT_APPLICATION_ID=5a4debca-e207-4934-90ba-d10efe0b6ab0
# Destino HTTPS: https://unicreditos.com/api/webhooks/didit
# Suscribí todos los eventos (no hay wildcard):
# status.updated, data.updated, user.status.updated, user.data.updated,
# business.status.updated, business.data.updated, activity.created,
# transaction.created, transaction.status.updated
# Si hay Cloudflare, permitir 18.203.201.92 (User-Agent DiditWebhook/2.0).

# --- Solo tests -----------------------------------------------
# NUNCA activar en producción: permite saltear la validación de sesión.
# ALLOW_SESSION_OVERRIDE=false
