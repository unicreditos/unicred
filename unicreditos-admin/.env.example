# URL del backend unicred (login JWT + API desk). En local, el repo unicred
# corre en el puerto 3000 (npm run dev) salvo que ya esté ocupado.
NEXT_PUBLIC_UNICRED_API_URL=http://localhost:3000

# Descomentar para volver al dataset mock en memoria (lib/data/mock) en vez
# del backend real — útil para cablear pantallas nuevas sin depender de la DB.
# NEXT_PUBLIC_ADMIN_USE_MOCK=1
